---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import { site } from '../site.config';
import { href } from '../lib/paths';

const all = await getCollection('apps');
const apps = all
  .filter((a) => a.data.status !== 'retired')
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const retired = all.filter((a) => a.data.status === 'retired');

// A strip of screenshots pulled from every app that has them.
const shots = apps.flatMap((a) => a.data.screenshots.slice(0, 2).map((src) => ({ src, name: a.data.name })));

const values = [
  ['01', 'On your device', 'Your files stay where they are. No uploads, no servers holding your data.'],
  ['02', 'No account', 'Open the app and use it. Nothing to sign up for, nothing to remember.'],
  ['03', 'No ads, no tracking', 'No advertising libraries and no analytics watching what you do.'],
  ['04', 'Built to last', 'One job each, done properly, and kept working as the platforms change.'],
];
---

<Base title={site.name} description={`Apps by ${site.name}. ${site.tagline}`}>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow r"><b>{apps.length} apps</b> in the workshop <i class="ping"></i></span>
      <h1 class="display r">Small tools, built with <span class="serif">care</span> and no tracking.</h1>
      <p class="lede r">{site.tagline} Made in {site.location}, shipped worldwide.</p>
      <div class="cta-row r">
        <a class="button magnetic" href="#apps" data-cursor>Browse the apps <span class="arrow">→</span></a>
        <a class="button secondary magnetic" href={`mailto:${site.email}`} data-cursor>Get in touch</a>
      </div>
    </div>
    <span class="scroll-hint" aria-hidden="true">Scroll<i></i></span>
  </section>

  <section class="wrap block" id="apps">
    <div class="section-head r">
      <h2>The apps</h2>
      <span class="count">{String(apps.length).padStart(2, '0')} — {new Date().getFullYear()}</span>
    </div>
    <div class="cards">
      {
        apps.map((app) => (
          <a class="card app r" href={href(`${app.id}/`)} style={`--accent:${app.data.accent}`} data-cursor>
            <div class="card-top">
              <AppIcon app={app} size={64} radius={18} />
              <div>
                <h3>{app.data.name}</h3>
                <span class="tag">{app.data.tagline}</span>
              </div>
            </div>
            <p class="muted">{app.data.summary}</p>
            <p class="chips">
              {app.data.mac || app.data.android ? (
                <span class="pill">
                  {[app.data.mac && 'Mac', app.data.android && 'Android'].filter(Boolean).join(' + ')} download
                </span>
              ) : (
                app.data.status === 'coming-soon' && <span class="pill">Coming soon</span>
              )}
              <span class="pill neutral">{app.data.category}</span>
            </p>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    shots.length > 0 && (
      <section class="showcase" aria-label="Screenshots from the apps">
        <div class="fade-l" /><div class="fade-r" />
        <div class="rail" data-rail>
          {shots.map((s) => (
            <Image
              src={s.src}
              alt={`${s.name} screenshot`}
              height={360}
              densities={[1, 2]}
              class="shot"
              style={`--ar:${(s.src.width / s.src.height).toFixed(4)}`}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap block">
    <div class="section-head r"><h2>How these apps work</h2></div>
    <div class="values">
      {
        values.map(([num, title, text]) => (
          <div class="value r">
            <div class="num">{num}</div>
            <h3>{title}</h3>
            <p class="muted">{text}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    retired.length > 0 && (
      <section class="wrap block">
        <h2 class="r">Earlier apps</h2>
        <ul class="retired r">
          {retired.map((app) => (
            <li>
              <a href={href(`${app.id}/`)}>{app.data.name}</a>
              <span class="muted"> · <a href={href(`${app.id}/privacy/`)}>privacy policy</a></span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .hero { min-height: 92svh; display: grid; align-content: center; padding: 90px 0 70px; position: relative; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 9px; padding: 7px 15px 7px 9px; margin-bottom: 26px;
    border: 1px solid var(--line); border-radius: 999px; background: var(--surface);
    backdrop-filter: blur(8px); font-size: .85rem; color: var(--muted);
  }
  .eyebrow b { color: var(--ink); font-weight: 500; }
  .ping { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-left: 4px; }
  .ping::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--accent); animation: ping 2.4s var(--ease-out) infinite; }
  @keyframes ping { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(2); opacity: 0; } }

  .display { font-size: clamp(2.8rem, 8.2vw, 6rem); max-width: 15ch; }
  .lede { font-size: clamp(1.05rem, 1.55vw, 1.3rem); color: var(--muted); max-width: 46ch; margin: 26px 0 34px; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .scroll-hint {
    position: absolute; bottom: 26px; left: 50%; translate: -50% 0; display: flex; flex-direction: column; align-items: center; gap: 10px;
    color: var(--muted); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase;
  }
  .scroll-hint i { width: 1px; height: 42px; background: linear-gradient(var(--muted), transparent); animation: drop 2.2s var(--ease) infinite; }
  @keyframes drop {
    0% { transform: scaleY(0); transform-origin: top; }
    60% { transform: scaleY(1); transform-origin: top; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  .block { padding: 90px 0 0; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 22px; margin-bottom: 26px; }
  .count { color: var(--muted); font-size: .9rem; font-variant-numeric: tabular-nums; }

  .cards { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); }
  .app { padding: 28px; color: inherit; text-decoration: none; display: block; }
  .card-top { display: flex; align-items: center; gap: 16px; }
  .app :global(.app-icon) { transition: transform .6s var(--ease-out); }
  .app:hover :global(.app-icon) { transform: translateZ(40px) rotate(-5deg) scale(1.06); }
  .app h3 { font-size: 1.3rem; }
  .tag { font-size: .84rem; color: var(--accent-ink); font-weight: 500; }
  .app p.muted { font-size: .96rem; margin: 18px 0; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0; }
  .go {
    position: absolute; right: 24px; bottom: 24px; width: 36px; height: 36px; display: grid; place-items: center;
    border-radius: 50%; background: var(--surface-2); color: var(--muted); opacity: 0; transform: translateX(-8px);
    transition: all .45s var(--ease-out);
  }
  .app:hover .go { opacity: 1; transform: translateZ(30px); color: var(--ink); }

  .showcase { position: relative; z-index: 2; padding: 70px 0 10px; overflow: hidden; }
  .rail { display: flex; gap: 18px; width: max-content; will-change: transform; }
  .rail :global(.shot) {
    height: min(360px, 42vh, calc(76vw / var(--ar, 1.6))); width: auto;
    border-radius: 18px; border: 1px solid var(--line);
    filter: saturate(.9) brightness(.95); transition: transform .6s var(--ease-out), filter .6s var(--ease);
  }
  .rail :global(.shot:hover) { transform: translateY(-10px) scale(1.03); filter: none; }
  .fade-l, .fade-r { position: absolute; top: 0; bottom: 0; width: 150px; z-index: 3; pointer-events: none; }
  .fade-l { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
  .fade-r { right: 0; background: linear-gradient(270deg, var(--bg), transparent); }

  .values { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  .value { padding: 28px; border-radius: 18px; border: 1px solid var(--line); background: var(--surface); backdrop-filter: blur(10px); }
  .value .num { font-family: 'Instrument Serif', Georgia, serif; font-size: 2.6rem; line-height: 1; color: var(--accent-ink); }
  .value h3 { margin: 14px 0 6px; }
  .value p { margin: 0; font-size: .93rem; }
  .retired { padding-left: 1.2em; }
</style>
