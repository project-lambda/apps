---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import { site } from '../site.config';
import { href } from '../lib/paths';

const all = await getCollection('apps');
const apps = all
  .filter((a) => a.data.status !== 'retired')
  .sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const retired = all.filter((a) => a.data.status === 'retired');

// A strip of screenshots pulled from every app that has them.
const shots = apps.flatMap((a) => a.data.screenshots.slice(0, 2).map((src) => ({ src, name: a.data.name })));

// Words starting with * are lit in the accent gradient.
const statement =
  'Every app here does *one *job. It works *on *your *device, never asks you to sign up, never shows you an ad, and keeps working long after launch.';
const words = statement.split(' ').map((w) => ({ text: w.replace(/^\*/, ''), lit: w.startsWith('*') }));

// Glyphs are 24px line icons, drawn to sit with the Inter text.
const values = [
  {
    num: '01', title: 'On your device', tint: '#34D399',
    text: 'Your files stay where they are. No uploads, no servers holding your data.',
    glyph: '<rect x="4" y="5" width="16" height="11" rx="2"/><path d="M2 19h20"/>',
  },
  {
    num: '02', title: 'No account', tint: '#38BDF8',
    text: 'Open the app and use it. Nothing to sign up for, nothing to remember.',
    glyph: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/><path d="M3 3l18 18"/>',
  },
  {
    num: '03', title: 'No ads, no tracking', tint: '#818CF8',
    text: 'No advertising libraries and no analytics watching what you do.',
    glyph: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/><path d="M3 3l18 18"/>',
  },
  {
    num: '04', title: 'Built to last', tint: '#C084FC',
    text: 'One job each, done properly, and kept working as the platforms change.',
    glyph: '<path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  },
];
---

<Base title={site.name} description={`Apps by ${site.name}. ${site.tagline}`}>
  <section class="hero">
    <div class="aurora" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

    <div class="wrap">
      <span class="eyebrow glass r"><b>{apps.length} apps</b> in the workshop <i class="ping"></i></span>
      <h1 class="display r">Small tools, built with <span class="serif">care</span> and no tracking.</h1>
      <p class="lede r">{site.tagline} Made in {site.location}, shipped worldwide.</p>
      <div class="cta-row r">
        <a class="button magnetic" href="#apps" data-cursor>Browse the apps <span class="arrow">→</span></a>
        <a class="button secondary magnetic" href={`mailto:${site.email}`} data-cursor>Get in touch</a>
      </div>
    </div>

    <!-- A drop of Liquid Glass to play with. Decorative, so it stays out of
         the accessibility tree and the tab order. -->
    <div class="lens" data-lens aria-hidden="true">
      <div class="lens-glass glass" data-liquid="52" data-bezel="30" data-chroma></div>
      <span class="lens-hint">Drag the glass</span>
    </div>

    <nav class="dock glass" data-dock data-liquid="30" data-bezel="14" aria-label="Apps">
      {
        apps.map((app) => (
          <a class="dock-item" href={href(`${app.id}/`)} aria-label={app.data.name}>
            <AppIcon app={app} size={112} radius={26} eager />
            <span class="dock-tip" aria-hidden="true">{app.data.name}</span>
          </a>
        ))
      }
      <span class="dock-sep" aria-hidden="true"></span>
      <a class="dock-item" href={`mailto:${site.email}`} aria-label="Email me">
        <span class="mail-tile">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="M3.8 7l8.2 6 8.2-6" /></svg>
        </span>
        <span class="dock-tip" aria-hidden="true">Say hello</span>
      </a>
    </nav>
  </section>

  <section class="wrap statement" id="approach" data-words style={`--n:${words.length}`}>
    <p class="kicker r">The approach</p>
    <p class="big">
      {
        words.map((w, i) => (
          <>
            <span class:list={['word', { lit: w.lit }]} style={`--i:${i}`}>{w.text}</span>{' '}
          </>
        ))
      }
    </p>
  </section>

  <section class="wrap block" id="apps">
    <div class="section-head r">
      <h2>The apps</h2>
      <span class="count">{String(apps.length).padStart(2, '0')} — {new Date().getFullYear()}</span>
    </div>
    <div class="cards">
      {
        apps.map((app) => (
          <a class="card app r" href={href(`${app.id}/`)} style={`--accent:${app.data.accent}`} data-cursor>
            <div class="card-top">
              <AppIcon app={app} size={64} radius={18} />
              <div>
                <h3>{app.data.name}</h3>
                <span class="tag">{app.data.tagline}</span>
              </div>
            </div>
            <p class="muted">{app.data.summary}</p>
            <p class="chips">
              {app.data.mac || app.data.android ? (
                <span class="pill">
                  {[app.data.mac && 'Mac', app.data.android && 'Android'].filter(Boolean).join(' + ')} download
                </span>
              ) : (
                app.data.status === 'coming-soon' && <span class="pill">Coming soon</span>
              )}
              <span class="pill neutral">{app.data.category}</span>
            </p>
            <span class="go" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>

  {
    shots.length > 0 && (
      <section class="showcase" aria-label="Screenshots from the apps">
        <div class="fade-l" /><div class="fade-r" />
        <div class="rail" data-rail>
          {shots.map((s) => (
            <Image
              src={s.src}
              alt={`${s.name} screenshot`}
              height={360}
              densities={[1, 2]}
              class="shot"
              style={`--ar:${(s.src.width / s.src.height).toFixed(4)}`}
            />
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap block">
    <div class="section-head r"><h2>How these apps work</h2></div>
    <div class="bento">
      <div class="card stack-tile r">
        <div class="iso" data-iso aria-hidden="true">
          <div class="iso-float">
            <div class="iso-stack">
              {
                values.map((v, i) => (
                  <div class="pane" style={`--i:${i};--tint:${v.tint}`} data-pane={i}>
                    <span class="pane-num">{v.num}</span>
                    <svg class="pane-glyph" viewBox="0 0 24 24" set:html={v.glyph} />
                  </div>
                ))
              }
            </div>
          </div>
          <div class="iso-shadow"></div>
        </div>
        <div class="stack-copy">
          <h3>Four promises, one stack</h3>
          <p class="muted">Every app is built on the same four layers. Pick a promise to see where it sits.</p>
        </div>
      </div>
      {
        values.map((v, i) => (
          <div class="card value r" style={`--tint:${v.tint};--accent:${v.tint}`} data-value={i}>
            <div class="value-top">
              <span class="chip">
                <svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.glyph} />
              </span>
              <span class="num">{v.num}</span>
            </div>
            <h3>{v.title}</h3>
            <p class="muted">{v.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    retired.length > 0 && (
      <section class="wrap block">
        <h2 class="r">Earlier apps</h2>
        <ul class="retired r">
          {retired.map((app) => (
            <li>
              <a href={href(`${app.id}/`)}>{app.data.name}</a>
              <span class="muted"> · <a href={href(`${app.id}/privacy/`)}>privacy policy</a></span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  /* ── hero ───────────────────────────────────────────────────── */
  .hero { min-height: 100svh; margin-top: -74px; display: grid; align-content: center; padding: 150px 0 190px; position: relative; overflow: clip; }

  /* Soft colour for the glass to bend: Liquid Glass reads as glass only
     when there is something behind it. */
  .aurora {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    -webkit-mask-image: linear-gradient(#000 55%, transparent); mask-image: linear-gradient(#000 55%, transparent);
  }
  .aurora i {
    position: absolute; width: 52vmax; aspect-ratio: 1; border-radius: 50%; opacity: .5; mix-blend-mode: screen;
    background: radial-gradient(circle, var(--c) 0%, transparent 62%);
    animation: drift 26s ease-in-out infinite alternate;
  }
  .aurora i:nth-child(1) { --c: color-mix(in oklab, #1fc98a 60%, transparent); left: -14vmax; top: -18vmax; }
  .aurora i:nth-child(2) { --c: color-mix(in oklab, #6366f1 62%, transparent); right: -16vmax; top: -8vmax; animation-duration: 31s; animation-delay: -8s; }
  .aurora i:nth-child(3) { --c: color-mix(in oklab, #38bdf8 46%, transparent); left: 26%; bottom: -30vmax; animation-duration: 23s; animation-delay: -4s; }
  .aurora i:nth-child(4) { --c: color-mix(in oklab, #c084fc 40%, transparent); right: 12%; bottom: -22vmax; width: 34vmax; animation-duration: 19s; }
  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(6vmax, 4vmax) scale(1.12); }
    100% { transform: translate(-4vmax, 7vmax) scale(.94); }
  }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 9px; padding: 7px 15px 7px 11px; margin-bottom: 26px;
    border-radius: 999px; font-size: .85rem; color: var(--muted);
  }
  .eyebrow b { color: var(--ink); font-weight: 500; }
  .ping { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-left: 4px; }
  .ping::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid var(--accent); animation: ping 2.4s var(--ease-out) infinite; }
  @keyframes ping { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(2); opacity: 0; } }

  /* Apple's headline treatment: bright at the top, falling to silver. */
  .display {
    font-size: clamp(2.8rem, 8.2vw, 6.2rem); max-width: 15ch; letter-spacing: -.045em; padding-bottom: .06em;
    background: linear-gradient(180deg, #fff 35%, #aab2c3); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .display .serif {
    padding-right: .06em;
    background: linear-gradient(100deg, #5ff0bb, #8ab6ff 55%, #c084fc); -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .lede { font-size: clamp(1.05rem, 1.55vw, 1.3rem); color: var(--muted); max-width: 46ch; margin: 26px 0 34px; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── the lens ──────────────────────────────────────────────── */
  .lens {
    --lw: clamp(140px, 20vw, 260px);
    /* Under the Dock, so a lens parked on it never blocks an icon. */
    position: absolute; left: 0; top: 0; z-index: 2; width: var(--lw); height: calc(var(--lw) * .5);
    touch-action: none; user-select: none; cursor: grab; opacity: 0; transition: opacity 1s var(--ease);
  }
  .lens.ready { opacity: 1; }
  .lens.held { cursor: grabbing; }
  .lens-glass {
    position: absolute; inset: 0; border-radius: 999px;
    --glass-blur: 1px; --liquid-blur: .4px; --glass-sat: 150%;
    --glass-fill: linear-gradient(180deg, color-mix(in oklab, white 6%, transparent), color-mix(in oklab, white 1%, transparent));
    box-shadow:
      inset 0 1px 1px color-mix(in oklab, white 55%, transparent),
      inset 0 -1px 1px color-mix(in oklab, white 22%, transparent),
      inset 0 0 20px color-mix(in oklab, white 12%, transparent),
      0 22px 44px -14px rgb(0 0 0 / .6);
    animation: bob 5.5s ease-in-out infinite;
    transition: scale .5s var(--spring);
  }
  /* A specular glint, fixed high on the lens like a window reflection. */
  .lens-glass::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: radial-gradient(90% 70% at 28% 0%, color-mix(in oklab, white 20%, transparent), transparent 55%);
  }
  .lens.held .lens-glass { scale: 1.08; animation-play-state: paused; }
  @keyframes bob { 50% { translate: 0 -7px; } }
  .lens-hint {
    position: absolute; top: 100%; left: 50%; translate: -50% 12px; white-space: nowrap; pointer-events: none;
    padding: 4px 11px; border-radius: 999px; font-size: .68rem; font-weight: 500; letter-spacing: .14em; text-transform: uppercase;
    color: var(--ink); background: color-mix(in oklab, #1b2130 80%, transparent); border: 1px solid color-mix(in oklab, white 12%, transparent);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    transition: opacity .6s var(--ease);
  }
  .lens.used .lens-hint { opacity: 0; }

  /* ── the Dock ──────────────────────────────────────────────── */
  .dock {
    --icon: 54px;
    position: absolute; left: 50%; bottom: 34px; translate: -50% 0; z-index: 3;
    display: flex; align-items: flex-end; gap: 10px; height: calc(var(--icon) + 20px); padding: 10px 12px;
    border-radius: 26px; --glass-blur: 24px;
  }
  .dock-item {
    --s: 1; position: relative; flex: none; display: block; border-radius: 23%; text-decoration: none;
    width: calc(var(--icon) * var(--s)); height: calc(var(--icon) * var(--s));
  }
  .dock-item :global(.app-icon), .mail-tile {
    width: 100% !important; height: 100% !important; border-radius: 23% !important;
    box-shadow: 0 8px 18px -6px rgb(0 0 0 / .55);
    transition: filter .2s var(--ease);
  }
  .dock-item :global(.letter) { font-size: calc(var(--icon) * var(--s) * .46) !important; }
  .dock-item:active :global(.app-icon), .dock-item:active .mail-tile { filter: brightness(.7); }
  .dock-item.launch { animation: launch .42s var(--ease) both; }
  @keyframes launch { 40% { transform: translateY(-22px); } 100% { transform: none; } }
  .mail-tile {
    display: grid; place-items: center;
    background: linear-gradient(160deg, #7dd3fc, #4f46e5);
  }
  .mail-tile svg { width: 58%; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .dock-sep { align-self: stretch; width: 1px; margin: 4px 2px; background: color-mix(in oklab, white 18%, transparent); }
  .dock-tip {
    position: absolute; bottom: calc(100% + 12px); left: 50%; translate: -50% 5px; white-space: nowrap; pointer-events: none;
    padding: 5px 11px; border-radius: 9px; font-size: .8rem; font-weight: 500; color: var(--ink); opacity: 0;
    background: color-mix(in oklab, #1b2130 78%, transparent); border: 1px solid color-mix(in oklab, white 10%, transparent);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    transition: opacity .2s var(--ease), translate .3s var(--ease-out);
  }
  .dock-item:hover .dock-tip, .dock-item:focus-visible .dock-tip { opacity: 1; translate: -50% 0; }
  @media (max-width: 760px) {
    /* No room under the lens on a phone, so the hint rides inside it. */
    .lens-hint { top: 50%; translate: -50% -50%; background: none; border-color: transparent; color: var(--muted); }
  }
  @media (max-width: 620px) {
    .cta-row { gap: 10px; }
    .cta-row .button { padding: 12px 17px; font-size: .95rem; }
    .dock { --icon: 44px; gap: 8px; bottom: 22px; padding: 8px 10px; border-radius: 22px; }
    .hero { padding-bottom: 150px; }
  }

  /* ── the statement ─────────────────────────────────────────── */
  .statement { --p: 1; padding: 150px 0 40px; }
  .kicker { font-size: .82rem; letter-spacing: .16em; text-transform: uppercase; color: var(--accent-ink); margin-bottom: 22px; }
  .big {
    font-size: clamp(1.9rem, 4.6vw, 3.7rem); line-height: 1.12; font-weight: 600; letter-spacing: -.035em; max-width: 24ch; margin: 0;
  }
  /* Each word lights once the scroll reaches it, trailing a few words of
     soft focus behind the reading edge. */
  .word {
    --o: clamp(.13, calc(var(--p) * (var(--n) + 5) - var(--i)), 1);
    display: inline-block; opacity: var(--o); filter: blur(calc((1 - var(--o)) * 2.5px));
    transition: opacity .25s linear, filter .25s linear;
  }
  .word.lit {
    background: linear-gradient(100deg, #5ff0bb, #8ab6ff 60%, #c084fc); -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  /* ── apps ──────────────────────────────────────────────────── */
  .block { padding: 90px 0 0; }
  .section-head { display: flex; align-items: end; justify-content: space-between; gap: 22px; margin-bottom: 26px; }
  .count { color: var(--muted); font-size: .9rem; font-variant-numeric: tabular-nums; }

  .cards { display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr)); }
  .app { padding: 28px; color: inherit; text-decoration: none; display: block; }
  .card-top { display: flex; align-items: center; gap: 16px; }
  .app :global(.app-icon) { transition: transform .6s var(--ease-out); box-shadow: 0 10px 24px -10px rgb(0 0 0 / .6); }
  .app:hover :global(.app-icon) { transform: translateZ(40px) rotate(-5deg) scale(1.06); }
  .app h3 { font-size: 1.3rem; }
  .tag { font-size: .84rem; color: var(--accent-ink); font-weight: 500; }
  .app p.muted { font-size: .96rem; margin: 18px 0; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 0; }
  .go {
    position: absolute; right: 24px; bottom: 24px; width: 36px; height: 36px; display: grid; place-items: center;
    border-radius: 50%; background: color-mix(in oklab, white 10%, transparent); color: var(--muted); opacity: 0; transform: translateX(-8px);
    box-shadow: inset 0 1px 0 color-mix(in oklab, white 22%, transparent);
    transition: all .45s var(--ease-out);
  }
  .app:hover .go { opacity: 1; transform: translateZ(30px); color: var(--ink); }

  .showcase { position: relative; z-index: 2; padding: 70px 0 10px; overflow: hidden; }
  .rail { display: flex; gap: 18px; width: max-content; will-change: transform; }
  .rail :global(.shot) {
    height: min(360px, 42vh, calc(76vw / var(--ar, 1.6))); width: auto;
    border-radius: 18px; border: 1px solid var(--line);
    filter: saturate(.9) brightness(.95); transition: transform .6s var(--ease-out), filter .6s var(--ease);
  }
  .rail :global(.shot:hover) { transform: translateY(-10px) scale(1.03); filter: none; }
  .fade-l, .fade-r { position: absolute; top: 0; bottom: 0; width: 150px; z-index: 3; pointer-events: none; }
  .fade-l { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
  .fade-r { right: 0; background: linear-gradient(270deg, var(--bg), transparent); }

  /* ── bento ─────────────────────────────────────────────────── */
  .bento { display: grid; gap: 18px; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(220px, auto); }
  .stack-tile { grid-column: span 2; grid-row: span 2; padding: 28px; display: flex; flex-direction: column; justify-content: space-between; }
  .stack-copy h3 { font-size: 1.4rem; margin-bottom: 6px; }
  .stack-copy p { margin: 0; max-width: 34ch; }

  .value { padding: 24px; display: flex; flex-direction: column; }
  .value-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: auto; padding-bottom: 22px; }
  .chip {
    width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; transition: transform .6s var(--ease-out);
    background: linear-gradient(160deg, color-mix(in oklab, var(--tint) 40%, transparent), color-mix(in oklab, var(--tint) 10%, transparent));
    box-shadow: inset 0 1px 0 color-mix(in oklab, white 35%, transparent), 0 10px 24px -10px color-mix(in oklab, var(--tint) 60%, transparent);
  }
  .chip svg { width: 24px; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .value:hover .chip { transform: translateZ(36px) scale(1.06); }
  .value .num { font-family: 'Instrument Serif', Georgia, serif; font-size: 2.3rem; line-height: 1; color: color-mix(in oklab, var(--tint) 70%, white); }
  .value h3 { margin: 0 0 6px; }
  .value p { margin: 0; font-size: .93rem; }

  /* ── the isometric stack ───────────────────────────────────── */
  /* No perspective on purpose: rotations without it are true isometric. */
  .iso { position: relative; flex: 1; min-height: 360px; display: grid; place-items: center; }
  .iso-float { animation: float 7s ease-in-out infinite; }
  @keyframes float { 50% { translate: 0 -10px; } }
  .iso-stack {
    --gap: 34px; --size: 220px;
    position: relative; width: var(--size); height: var(--size);
    transform-style: preserve-3d; transform: rotateX(58deg) rotateZ(-45deg);
  }
  :global(.js) .iso-stack:not(.open) { --gap: 5px; }
  .pane {
    position: absolute; inset: 0; border-radius: 34px;
    transform: translateZ(calc((3 - var(--i)) * var(--gap)));
    background:
      linear-gradient(135deg, color-mix(in oklab, white 30%, transparent), transparent 42%),
      linear-gradient(135deg, color-mix(in oklab, var(--tint) 58%, transparent), color-mix(in oklab, var(--tint) 16%, transparent));
    border: 1px solid color-mix(in oklab, white 42%, transparent);
    box-shadow: inset 0 0 22px color-mix(in oklab, white 14%, transparent), 0 0 0 1px color-mix(in oklab, var(--tint) 30%, transparent);
    transition: transform .9s var(--spring), opacity .5s var(--ease), box-shadow .5s var(--ease);
    transition-delay: calc((3 - var(--i)) * 50ms);
  }
  .pane-num { position: absolute; left: 16px; top: 12px; font-family: 'Instrument Serif', Georgia, serif; font-size: 1.6rem; color: #fff; opacity: .85; }
  .pane-glyph { position: absolute; right: 18px; bottom: 18px; width: 44px; fill: none; stroke: #fff; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; opacity: .9; }
  .iso-stack[data-active] .pane { opacity: .28; }
  .iso-stack[data-active='0'] .pane[data-pane='0'],
  .iso-stack[data-active='1'] .pane[data-pane='1'],
  .iso-stack[data-active='2'] .pane[data-pane='2'],
