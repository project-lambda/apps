---
import { getCollection, getEntry, render } from 'astro:content';
import Document from '../../components/Document.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  const policies = await getCollection('policies');
  return policies.flatMap((entry) => {
    const app = apps.find((a) => a.id === entry.id);
    return app ? [{ params: { app: app.id }, props: { app, entry } }] : [];
  });
}

const { app, entry } = Astro.props;
const { Content } = await render(entry);
const hasTerms = !!(await getEntry('terms', app.id));
---

<Document app={app} kind="privacy" entry={entry} hasTerms={hasTerms}>
  <Content />
</Document>
