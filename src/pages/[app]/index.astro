---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppNav from '../../components/AppNav.astro';
import AppIcon from '../../components/AppIcon.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { href } from '../../lib/paths';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { app: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { Content } = await render(app);
const [policy, terms] = await Promise.all([getEntry('policies', app.id), getEntry('terms', app.id)]);
// Both stores reject a listing without a privacy policy, so the build does too.
if (!policy) throw new Error(`${app.id}: add src/content/apps/${app.id}/privacy.md`);
const d = app.data;
---

<Base title={d.name} description={d.summary} accent={d.accent} image={d.icon?.src}>
  <AppNav app={app} current="overview" hasTerms={!!terms} />

  <section class="wrap hero">
    <div class="r icon-wrap"><AppIcon app={app} size={120} radius={28} eager /></div>
    <div>
      <h1 class="r">{d.name}</h1>
      <p class="tagline r">{d.tagline}</p>
      <p class="summary muted r">{d.summary}</p>
      <div class="r"><StoreButtons app={app} /></div>
    </div>
  </section>

  {
    d.screenshots.length > 0 && (
      <section class="showcase" aria-label={`${d.name} screenshots`}>
        <div class="strip">
          {d.screenshots.map((shot, i) => (
            <Image src={shot} alt={`${d.name} screenshot ${i + 1}`} height={520} densities={[1, 2]} class="shot" />
          ))}
        </div>
      </section>
    )
  }

  {
    d.features.length > 0 && (
      <section class="wrap block">
        <h2 class="r">Features</h2>
        <div class="features">
          {d.features.map((f) => (
            <div class="card feature r">
              <h3>{f.title}</h3>
              <p class="muted">{f.text}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap narrow block">
    <h2 class="r">About {d.name}</h2>
    <div class="prose r"><Content /></div>
    <p class="links muted r">
      <a href={href(`${app.id}/privacy/`)}>Privacy policy</a>
      {terms && <a href={href(`${app.id}/terms/`)}>Terms of use</a>}
      <a href={href(`${app.id}/support/`)}>Support</a>
    </p>
  </section>
</Base>

<style>
  .hero { display: flex; gap: 34px; align-items: flex-start; padding: 60px 0 34px; }
  .icon-wrap :global(.app-icon) { box-shadow: 0 18px 50px color-mix(in oklab, var(--accent) 22%, transparent); }
  .tagline { font-size: 1.25rem; font-weight: 600; color: var(--accent-ink); margin: 6px 0 10px; }
  .summary { max-width: 38em; margin: 0 0 22px; }

  .showcase { padding: 10px 0 20px; }
  .strip {
    display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 10px max(22px, calc((100vw - 1120px) / 2)) 20px;
  }
  .shot {
    height: 520px; width: auto; border-radius: 18px; border: 1px solid var(--line); flex: none; scroll-snap-align: center;
    filter: saturate(.92); transition: transform .6s var(--ease-out), filter .6s var(--ease);
  }
  .shot:hover { transform: translateY(-10px) scale(1.02); filter: none; }

  .block { padding-top: 70px; }
  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; margin-top: 22px; }
  .feature { padding: 24px; }
  .feature h3 { margin: 0 0 6px; }
  .feature p { margin: 0; font-size: .95rem; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 40px; }

  @media (max-width: 680px) {
    .hero { flex-direction: column; gap: 20px; padding-top: 40px; }
    .shot { height: 380px; }
  }
</style>
