---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AppNav from '../../components/AppNav.astro';
import AppIcon from '../../components/AppIcon.astro';
import StoreButtons from '../../components/StoreButtons.astro';
import { href } from '../../lib/paths';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { app: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { Content } = await render(app);
const [policy, terms] = await Promise.all([getEntry('policies', app.id), getEntry('terms', app.id)]);
// Both stores reject a listing without a privacy policy, so the build does too.
if (!policy) throw new Error(`${app.id}: add src/content/apps/${app.id}/privacy.md`);
const d = app.data;
---

<Base title={d.name} description={d.summary} accent={d.accent} image={d.icon?.src}>
  <AppNav app={app} current="overview" hasTerms={!!terms} />

  <section class="wrap hero">
    <div class="r icon-wrap"><AppIcon app={app} size={120} radius={28} eager /></div>
    <div>
      <h1 class="r">{d.name}</h1>
      <p class="tagline r">{d.tagline}</p>
      <p class="summary muted r">{d.summary}</p>
      <div class="r"><StoreButtons app={app} /></div>
    </div>
  </section>

  {
    d.video && (
      <section class="wrap demo r">
        <figure>
          <video
            class="demo-video"
            poster={d.video.poster.src}
            muted
            loop
            playsinline
            controls
            preload="none"
            data-demo
          >
            <source src={href(d.video.file)} type="video/mp4" />
          </video>
          {d.video.caption && <figcaption class="muted">{d.video.caption}</figcaption>}
        </figure>
      </section>
    )
  }

  {
    d.screenshots.length > 0 && (
      <section class="showcase" aria-label={`${d.name} screenshots`}>
        <button class="nudge prev" type="button" aria-label="Previous screenshots" data-shots-prev>‹</button>
        <button class="nudge next" type="button" aria-label="More screenshots" data-shots-next>›</button>
        <div class="strip" data-shots>
          {d.screenshots.map((shot, i) => (
            <Image
              src={shot}
              alt={`${d.name} screenshot ${i + 1}`}
              height={520}
              densities={[1, 2]}
              class="shot"
              style={`--ar:${(shot.width / shot.height).toFixed(4)}`}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    d.features.length > 0 && (
      <section class="wrap block">
        <h2 class="r">Features</h2>
        <div class="features">
          {d.features.map((f) => (
            <div class="card feature r">
              <h3>{f.title}</h3>
              <p class="muted">{f.text}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <section class="wrap narrow block">
    <h2 class="r">About {d.name}</h2>
    <div class="prose r"><Content /></div>
    <p class="links muted r">
      <a href={href(`${app.id}/privacy/`)}>Privacy policy</a>
      {terms && <a href={href(`${app.id}/terms/`)}>Terms of use</a>}
      <a href={href(`${app.id}/support/`)}>Support</a>
    </p>
  </section>
</Base>

<style>
  .hero { display: flex; gap: 34px; align-items: flex-start; padding: 60px 0 34px; }
  .icon-wrap :global(.app-icon) { box-shadow: 0 18px 50px color-mix(in oklab, var(--accent) 22%, transparent); }
  .tagline { font-size: 1.25rem; font-weight: 600; color: var(--accent-ink); margin: 6px 0 10px; }
  .summary { max-width: 38em; margin: 0 0 22px; }

  .demo { padding-top: 18px; }
  .demo figure { margin: 0; }
  .demo-video {
    width: 100%; height: auto; display: block; border-radius: 18px; border: 1px solid var(--line);
    background: #000; box-shadow: 0 30px 70px color-mix(in oklab, var(--accent) 14%, transparent);
  }
  .demo figcaption { margin-top: 12px; font-size: .9rem; }

  .showcase { padding: 10px 0 20px; position: relative; }
  /* Horizontal strips need an obvious way forward, so the arrows sit on the
     rail itself and the right one waves until the visitor scrolls it once. */
  .nudge {
    position: absolute; top: 50%; translate: 0 -50%; z-index: 4;
    width: 52px; height: 52px; display: grid; place-items: center;
    font-size: 1.9rem; line-height: 1; padding-bottom: 5px;
    border-radius: 50%; cursor: pointer;
    color: var(--ink); background: color-mix(in oklab, var(--surface) 92%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 45%, var(--line));
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px color-mix(in oklab, var(--accent) 18%, transparent);
    transition: transform .35s var(--ease-out), opacity .35s var(--ease), background-color .35s var(--ease);
  }
  .nudge:hover { transform: translateY(-50%) scale(1.1); background: color-mix(in oklab, var(--accent) 22%, var(--surface)); }
  .nudge.prev { left: max(14px, calc((100vw - 1200px) / 2)); }
  .nudge.next { right: max(14px, calc((100vw - 1200px) / 2)); animation: wave 2.6s var(--ease) infinite; }
  .nudge[hidden] { display: none; }
  .nudge:disabled { opacity: .25; pointer-events: none; animation: none; }
  .showcase.touched .nudge.next { animation: none; }
  @keyframes wave {
    0%, 55%, 100% { transform: translate(0, -50%); }
    70% { transform: translate(7px, -50%); }
    85% { transform: translate(0, -50%); }
  }
  @media (prefers-reduced-motion: reduce) { .nudge.next { animation: none; } }
  .strip {
    display: flex; gap: 18px; overflow-x: auto; scroll-snap-type: x mandatory;
    padding: 10px max(22px, calc((100vw - 1120px) / 2)) 20px;
  }
  .shot {
    /* A definite height keeps the space reserved before the image loads;
       the third term is what stops a wide shot running off a narrow screen. */
    height: min(520px, 62vh, calc(88vw / var(--ar, 1.6)));
    width: auto;
    border-radius: 18px; border: 1px solid var(--line); flex: none; scroll-snap-align: center;
    filter: saturate(.92); transition: transform .6s var(--ease-out), filter .6s var(--ease);
  }
  .shot:hover { transform: translateY(-10px) scale(1.02); filter: none; }

  .block { padding-top: 70px; }
  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 16px; margin-top: 22px; }
  .feature { padding: 24px; }
  .feature h3 { margin: 0 0 6px; }
  .feature p { margin: 0; font-size: .95rem; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; margin-top: 40px; }

  @media (max-width: 680px) {
    .hero { flex-direction: column; gap: 20px; padding-top: 40px; }
    .shot { height: min(54vh, calc(84vw / var(--ar, 1.6))); }
    .strip { padding-inline: 7vw; gap: 12px; }
    .nudge { width: 42px; height: 42px; font-size: 1.5rem; }
    .nudge.prev { left: 6px; }
    .nudge.next { right: 6px; }
  }
</style>

<script>
  // The demo plays itself once it is on screen and stops when it leaves, so
  // it never runs in a background tab. Reduced motion leaves it paused with
  // its poster and controls.
  const demo = document.querySelector<HTMLVideoElement>('[data-demo]');
  if (demo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (en.isIntersecting) {
            demo.preload = 'auto';
            demo.play().catch(() => {});
          } else {
            demo.pause();
          }
        }
      },
      { threshold: 0.4 },
    );
    io.observe(demo);
  }

  // Arrow controls for the screenshot strip. Kept out of the animation
  // bundle so they still work with reduced motion, where that never loads.
  const strip = document.querySelector<HTMLElement>('[data-shots]');
  const prev = document.querySelector<HTMLButtonElement>('[data-shots-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-shots-next]');

  if (strip && prev && next) {
    const step = () => Math.max(240, strip.clientWidth * 0.7);
    const sync = () => {
      const overflow = strip.scrollWidth - strip.clientWidth;
      const hide = overflow < 20;
      prev.hidden = hide;
      next.hidden = hide;
      prev.disabled = strip.scrollLeft < 12;
      next.disabled = strip.scrollLeft > overflow - 12;
    };
    const go = (dir: number) => {
      strip.closest('.showcase')?.classList.add('touched');
      strip.scrollBy({ left: dir * step(), behavior: 'smooth' });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    strip.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    addEventListener('load', sync);
    sync();
  }
</script>
