---
import type { CollectionEntry } from 'astro:content';
import AppIcon from './AppIcon.astro';
import { href } from '../lib/paths';

interface Props {
  app: CollectionEntry<'apps'>;
  current: 'overview' | 'privacy' | 'terms' | 'support' | 'delete-account';
  hasTerms: boolean;
}

const { app, current, hasTerms } = Astro.props;
const tabs = [
  { key: 'overview', label: 'Overview', path: `${app.id}/` },
  { key: 'privacy', label: 'Privacy', path: `${app.id}/privacy/` },
  ...(hasTerms ? [{ key: 'terms', label: 'Terms', path: `${app.id}/terms/` }] : []),
  { key: 'support', label: 'Support', path: `${app.id}/support/` },
  ...(app.data.accounts
    ? [{ key: 'delete-account', label: 'Delete account', path: `${app.id}/delete-account/` }]
    : []),
];
---

<div class="app-nav">
  <div class="wrap">
    <a class="identity" href={href(`${app.id}/`)}>
      <AppIcon app={app} size={40} radius={10} eager />
      <span>{app.data.name}</span>
    </a>
    <nav class="glass" aria-label={`${app.data.name} pages`}>
      {tabs.map((t) => (
        <a href={href(t.path)} aria-current={t.key === current ? 'page' : undefined}>
          {t.label}
        </a>
      ))}
    </nav>
  </div>
</div>

<style>
  .app-nav { padding-top: 18px; }
  .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 12px; padding-bottom: 12px; }
  .identity { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--ink); text-decoration: none; }
  /* A segmented control in glass, the selected page lifted out of it. */
  nav { display: flex; gap: 2px; overflow-x: auto; padding: 4px; border-radius: 999px; max-width: 100%; }
  nav a {
    padding: 7px 14px;
    border-radius: 999px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.93rem;
    white-space: nowrap;
    transition: color .3s var(--ease), background-color .3s var(--ease);
  }
  nav a:hover { color: var(--ink); background: color-mix(in oklab, white 7%, transparent); }
  nav a[aria-current='page'] {
    color: var(--ink);
    background: linear-gradient(180deg, color-mix(in oklab, var(--accent) 34%, transparent), color-mix(in oklab, var(--accent) 16%, transparent));
    box-shadow: inset 0 1px 0 color-mix(in oklab, white 30%, transparent), 0 6px 16px -8px color-mix(in oklab, var(--accent) 70%, transparent);
  }
</style>
