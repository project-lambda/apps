---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import type { CollectionEntry } from 'astro:content';
import { href } from '../lib/paths';

interface Props {
  app: CollectionEntry<'apps'>;
}

const { id, data } = Astro.props.app;
const { status, stores, name, mac, android } = data;
const links = [
  stores.googlePlay && { label: 'Get it on Google Play', url: stores.googlePlay },
  stores.appStore && { label: 'Download on the App Store', url: stores.appStore },
  stores.web && { label: 'Open on the web', url: stores.web },
].filter(Boolean) as { label: string; url: string }[];

// Statting the file also fails the build when app.md points at a download
// that was never copied into public/.
const size = (file: string) => `${Math.round(statSync(join(process.cwd(), 'public', file)).size / 1e6)} MB`;
const downloads =
  status === 'retired'
    ? []
    : ([
        mac && {
          label: 'Download for Mac',
          file: mac.file,
          meta: `Mac · version ${mac.version} · ${size(mac.file)} · macOS ${mac.minimumOS} or later, Apple Silicon and Intel`,
        },
        android && {
          label: 'Download the APK',
          file: android.file,
          meta: `Android · version ${android.version} · ${size(android.file)} · Android ${android.minimumOS} or later`,
        },
      ].filter(Boolean) as { label: string; file: string; meta: string }[]);
// Store listings come first once the app is live; direct downloads follow.
const buttons = [
  ...(status === 'live' ? links.map((l) => ({ ...l, download: false })) : []),
  ...downloads.map((d) => ({ label: d.label, url: href(d.file), download: true })),
];
const upcoming = [stores.googlePlay && 'Google Play', stores.appStore && 'the App Store'].filter(Boolean);
---

{
  buttons.length > 0 && (
    <div class="get">
      <div class="stores">
        {buttons.map((b, i) => (
          <a
            class:list={['button', { secondary: i > 0 }]}
            href={b.url}
            {...(b.download ? { download: true } : { rel: 'noopener' })}
          >
            {b.label} {b.download && <span class="arrow">↓</span>}
          </a>
        ))}
      </div>
      {downloads.map((d) => (
        <p class="meta muted">{d.meta}</p>
      ))}
      {downloads.length > 0 && (
        <p class="meta muted">
          Installing a download for the first time? <a href={href(`${id}/support/`)}>Here is how</a>.
        </p>
      )}
    </div>
  )
}

{
  status === 'coming-soon' && downloads.length > 0 ? (
    upcoming.length > 0 && (
      <p class="soon"><span class="pill">Coming soon</span> {name} is on its way to {upcoming.join(' and ')}.</p>
    )
  ) : status === 'coming-soon' ? (
    <p class="soon"><span class="pill">Coming soon</span> {name} is still in development. This page gets a link the day it ships.</p>
  ) : status === 'retired' ? (
    <p class="soon"><span class="pill neutral">No longer available</span> This page stays up for existing users.</p>
  ) : null
}

<style>
  .stores { display: flex; flex-wrap: wrap; gap: 10px; }
  .soon { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; color: var(--muted); margin: 0; }
  .get { margin-bottom: 18px; }
  .get .stores { margin-bottom: 12px; }
  .meta { font-size: .88rem; margin: 4px 0 0; max-width: 38em; }
</style>
