---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AppNav from './AppNav.astro';
import { formatDate } from '../lib/paths';

interface Props {
  app: CollectionEntry<'apps'>;
  kind: 'privacy' | 'terms';
  entry: CollectionEntry<'policies'> | CollectionEntry<'terms'>;
  hasTerms: boolean;
}

const { app, kind, entry, hasTerms } = Astro.props;
const heading = kind === 'privacy' ? 'Privacy Policy' : 'Terms of Use';
const { effectiveDate, updated } = entry.data;
---

<Base
  title={`${heading} · ${app.data.name}`}
  description={`${heading} for ${app.data.name}.`}
  accent={app.data.accent}
>
  <AppNav app={app} current={kind} hasTerms={hasTerms} />
  <article class="wrap narrow doc">
    <h1>{app.data.name} {heading}</h1>
    <p class="muted dates">
      Effective {formatDate(effectiveDate)}
      {updated && <> · Last updated {formatDate(updated)}</>}
    </p>
    <div class="prose"><slot /></div>
  </article>
</Base>

<style>
  .doc { padding-top: 48px; }
  .doc h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); }
  .dates { margin: 0 0 32px; }
</style>
